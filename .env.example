# Variáveis lidas pelo Docker Compose (copie para .env).

# PostgreSQL
POSTGRES_DB=c216_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DB_PORT=5433

# API FastAPI
API_PORT=8000
# Origens autorizadas pelo CORS (lista separada por vírgulas).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
FRONTEND_PORT=5173
# Exposta ao navegador: nunca coloque segredos em variáveis VITE_*.
VITE_API_URL=http://localhost:8000
